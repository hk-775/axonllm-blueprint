AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_IDS=us.amazon.nova-2-lite-v1:0,us.anthropic.claude-sonnet-4-6
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=3001
VERIFY_BEDROCK_ON_STARTUP=false
BLUEPRINT_TRUST_AUTH_PROXY=false
BLUEPRINT_ALLOW_UNAUTHENTICATED=false
BLUEPRINT_AUTH_HEADER=x-blueprint-user
BLUEPRINT_TRUST_PROXY_HOPS=0
BLUEPRINT_RATE_LIMIT_WINDOW_MS=60000
BLUEPRINT_RATE_LIMIT_MAX_REQUESTS=12
